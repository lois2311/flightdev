# Public site
NEXT_PUBLIC_SITE_URL=https://flightdev.dev
NEXT_PUBLIC_CONTACT_EMAIL=hello@flightdev.dev
# Optional: Google Analytics 4 measurement id (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
# Optional: Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random string used to hash visitor IPs for rate limiting (no raw IPs are stored)
LEAD_IP_SALT=
